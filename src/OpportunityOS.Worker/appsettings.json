{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Hangfire": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=opportunity_os;Username=postgres;Password=postgres"
  },
  "Llm": {
    "Provider": "auto"
  },
  "Anthropic": {
    "ApiKey": "",
    "Model": "claude-sonnet-4-6"
  },
  "OpenAI": {
    "ApiKey": "",
    "Model": "gpt-4.1-mini"
  },
  "Jobs": {
    "DailyDiscoveryCron": "0 8 * * *",
    "ContinuousDiscoveryCron": "*/15 * * * *",
    "SearchCron": "0 */3 * * *",
    "DailyDigestCron": "0 9 * * *",
    "ValidateLinksCron": "30 */6 * * *",
    "FirehoseCron": "0 */4 * * *",
    "FirehoseMaxQueries": 60,
    "PromotionCron": "30 */4 * * *",
    "PromotionMax": 50,
    "PromotionMinConfidence": 50,
    "BacenSweepCron": "0 6 * * 1",
    "BacenSweepMaxCompanies": 50,
    "BacenSweepQueriesPerCompany": 8,
    "ConsultingRadarCron": "0 7 * * 2",
    "ConsultingMaxQueries": 8
  },
  "Search": {
    "Provider": "GoogleCustomSearch",
    "ApiKey": "",
    "SearchEngineId": "",
    "DailyQueryBudget": 90,
    "SerperApiKey": "",
    "SerperMaxQueriesPerCall": 6,
    "SerperFreshness": "qdr:m"
  },
  "FeatureFlags": {
    "EnableLeverProvider": true,
    "EnableGreenhouseProvider": true,
    "EnableSmartRecruitersProvider": true,
    "EnableAshbyProvider": true,
    "EnableGupyProvider": true,
    "EnableGoogleWebSearch": true,
    "EnableSerperWebSearch": true,
    "EnableGenericCrawler": true,
    "EnableLlmAnalysis": true,
    "EnableEmailDigest": true,
    "EnableBacenSweepJob": false,
    "EnableConsultingRadarJob": false
  }
}
